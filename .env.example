# ===================================================================
# IBVAP-X — Environment & Operational Configuration (.env.example)
# Reliability-Aware Border Video Intelligence
# ===================================================================

# System & App Environment
APP_NAME=IBVAP-X
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Server Host & Ports
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501

# Database Configuration
# DATABASE_MODE options: auto | postgres | sqlite
# - auto: Tries PostgreSQL; falls back to local SQLite if PostgreSQL is unreachable.
# - postgres: Forces PostgreSQL connection (fails explicitly if unreachable).
# - sqlite: Forces local SQLite database (standalone local demo mode).
DATABASE_MODE=auto
DB_URL_POSTGRES=postgresql+psycopg://postgres:postgres@localhost:5432/ibvapx_dev
DB_URL_SQLITE=sqlite:///./data/ibvapx_local.db

# Object Detection (YOLO)
YOLO_MODEL_PATH=data/models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_DETECT_CLASSES=person,car,motorcycle,bus,truck

# Object Tracking (ByteTrack)
TRACK_EVICTION_FRAMES=30
TRACK_MIN_TRAJECTORY_FRAMES=15

# Context & Operational Hours
DAY_START_HOUR=6
NIGHT_START_HOUR=18
LOITERING_THRESHOLD_SECONDS=30
LOITERING_COOLDOWN_SECONDS=60
DIRECTION_MIN_FRAMES=10

# Camera Reliability Thresholds & Sub-Metric Weights
BLUR_THRESHOLD=50.0
BRIGHTNESS_MIN=40.0
BRIGHTNESS_MAX=220.0
RELIABILITY_WEIGHT_BLUR=0.35
RELIABILITY_WEIGHT_BRIGHTNESS=0.25
RELIABILITY_WEIGHT_FRAME=0.25
RELIABILITY_WEIGHT_OBSTRUCTION=0.15

RELIABILITY_GOOD_THRESHOLD=80.0
RELIABILITY_DEGRADED_THRESHOLD=50.0
RELIABILITY_POOR_THRESHOLD=20.0

# Priority Scoring Thresholds (Documented Prototype Policy Parameters)
PRIORITY_LOW_MAX=40
PRIORITY_MEDIUM_MAX=65
PRIORITY_HIGH_MAX=84

# Actionability & Escalation
ACK_TIMEOUT_SECONDS=30
PRE_EVENT_SECONDS=10
POST_EVENT_SECONDS=10
EVIDENCE_STORAGE_DIR=data/evidence

# Cross-Camera Correlation
CORRELATION_WINDOW_SECONDS=40

# Anomaly Engine (IsolationForest)
ANOMALY_CONTAMINATION=0.10
ANOMALY_SCORE_THRESHOLD=0.50
ANOMALY_MODEL_PATH=data/anomaly_models/ibvapx_anomaly_model.pkl

# Security & CORS
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
